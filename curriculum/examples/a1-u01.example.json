    "grammar": [
      {
        "id": "g-be-i-am",
        "name": "be: I am / I'm",
        "pattern": "I am + name. I'm + name. My name is + name.",
        "note": {
          "en": "English needs the verb 'am' here. Say 'I am Rina' or 'I'm Rina'. 'I Rina' is not correct.",
          "id": "Bahasa Inggris membutuhkan kata kerja 'am' di sini. Katakan 'I am Rina' atau 'I'm Rina'. 'I Rina' tidak benar."
        }
      },
      {
        "id": "g-be-from",
        "name": "be + from",
        "pattern": "I'm from + place.",
        "note": {
          "en": "Use 'from' before the name of your city or country.",
          "id": "Gunakan 'from' sebelum nama kota atau negara Anda."
        }
      },
