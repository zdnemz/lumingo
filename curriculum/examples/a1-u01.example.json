  "presentation": [
    {
      "id": "pr-greetings-by-time",
      "kind": "explanation",
      "text": {
        "en": "Say 'Good morning' before 12:00, 'Good afternoon' from 12:00 until about 6 p.m., and 'Good evening' after that. 'Hello' and 'Hi' are fine at any time. 'Hi' is more casual.",
        "id": "Ucapkan 'Good morning' sebelum pukul 12.00, 'Good afternoon' dari pukul 12.00 sampai sekitar pukul 18.00, dan 'Good evening' setelah itu. 'Hello' dan 'Hi' bisa dipakai kapan saja. 'Hi' lebih santai."
      },
      "examples": [
        {
          "en": "Good morning, Dewi!",
          "id": "Selamat pagi, Dewi!"
        },
        {
          "en": "Good evening. I'm Arif.",
          "id": "Selamat malam. Saya Arif."
        }
      ]
    },
    {
      "id": "pr-good-night",
      "kind": "tip",
      "text": {
        "en": "'Good night' is not a greeting. Use it only when you leave at night or go to bed. When you meet someone at night, say 'Good evening'.",
        "id": "'Good night' bukan sapaan. Gunakan hanya saat berpamitan di malam hari atau hendak tidur. Saat bertemu seseorang di malam hari, ucapkan 'Good evening'."
      }
    },
    {
      "id": "pr-i-am",
      "kind": "explanation",
      "text": {
        "en": "'I'm' is the short form of 'I am'. 'I'm Rina' and 'My name is Rina' mean the same thing. In Indonesian you can say 'Saya Rina', but in English you must keep 'am': 'I am Rina'.",
        "id": "'I'm' adalah bentuk singkat dari 'I am'. 'I'm Rina' dan 'My name is Rina' artinya sama. Dalam bahasa Indonesia kita bisa berkata 'Saya Rina', tetapi dalam bahasa Inggris 'am' harus tetap ada: 'I am Rina'."
      },
      "examples": [
        {
          "en": "I'm Dewi. I'm from Bandung.",
          "id": "Saya Dewi. Saya dari Bandung."
        },
        {
          "en": "My name is Arif.",
          "id": "Nama saya Arif."
        }
      ]
    },
    {
      "id": "pr-th-sound",
      "kind": "tip",
      "text": {
        "en": "For 'th' in 'thank', put the tip of your tongue lightly between your teeth and push air out. Do not stop the air. If you stop the air, it sounds like 't' and 'thank' becomes 'tank'.",
        "id": "Untuk bunyi 'th' pada 'thank', letakkan ujung lidah dengan ringan di antara gigi lalu hembuskan udara. Jangan hentikan aliran udaranya. Jika udara terhenti, bunyinya menjadi 't' dan 'thank' terdengar seperti 'tank'."
      }
    }
  ],
