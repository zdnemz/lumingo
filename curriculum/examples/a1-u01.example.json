          "speaker": "Dewi",
          "text": "Nice to meet you, Arif."
        },
        {
          "speaker": "Arif",
          "text": "Nice to meet you too. Where are you from?"
        },
        {
          "speaker": "Dewi",
          "text": "I'm from Bandung. And you?"
        },
        {
          "speaker": "Arif",
          "text": "I'm from Makassar."
        },
        {
          "speaker": "Dewi",
          "text": "How are you today?"
        },
